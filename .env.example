# --- Доступ до веб-CRM
OWNER_LOGIN=vadim
# пароль власника при першому запуску (потім змінюється в «Мій кабінет»)
ADMIN_PASSWORD=придумайте-надійний-пароль
SECRET_KEY=довгий-випадковий-рядок
# домен CRM: DNS A-запис → IP сервера; Caddy сам отримає HTTPS-сертифікат
DOMAIN=crm.molodist.com.ua
PUBLIC_URL=https://crm.molodist.com.ua
POSTGRES_PASSWORD=змініть-мене

# --- CleverBox REST API v3
# CleverBox → Налаштування → модуль REST API → згенерувати токен
# і ОБОВ'ЯЗКОВО додати IP вашого VPS у дозволені адреси (інакше помилка 2)
CLEVERBOX_TOKEN=
# CLEVERBOX_FILIAL_ID=        # якщо філій кілька і потрібна лише одна

# --- Telegram (бот через @BotFather; ID чатів — команда /id у чаті з ботом)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=          # чат адмінів, куди йдуть нагадування
TELEGRAM_ALLOWED_CHAT_IDS=       # робочі чати, з яких бот приймає PDF і фото (через кому)

# --- Google Sheets (необов'язково)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/google-sa.json
GOOGLE_SHEET_ID=

# --- Логіка нагадувань
REMIND_NOT_BOOKED_AFTER_DAYS=2
REMIND_CARE_DAYS_BEFORE_END=10
REMIND_HOUR=10
DEFAULT_PROCEDURE_INTERVAL_DAYS=28
SYNC_LOOKBACK_DAYS=120

# --- Сповіщення про збої (синк, бекап, блокування входу)
# порожньо = власникам, які вказали Telegram chat ID у «Мій кабінет»
TELEGRAM_ALERT_CHAT_ID=

# --- Резервні копії (щодня о BACKUP_HOUR:30)
# папка на сервері для копій; краще окремий диск: /mnt/backup-disk/molodist-crm
BACKUP_HOST_DIR=./backups
BACKUP_KEEP=14
BACKUP_HOUR=3
# друга копія: папка на іншому диску / змонтована хмара (rclone mount) на сервері,
# і тоді BACKUP_COPY_DIR=/app/backups-copy; порожній BACKUP_COPY_DIR = вимкнено
BACKUP_COPY_HOST_DIR=
BACKUP_COPY_DIR=
# пароль шифрування копії, що надсилається власнику в Telegram (без пароля в Telegram не надсилається)
# ЗБЕРЕЖІТЬ ЙОГО ОКРЕМО (менеджер паролів) — без нього копію з Telegram не відновити
BACKUP_PASSWORD=

# --- Бот для пацієнтів (OpenClaw): CRM надсилає пацієнтам повідомлення його токеном
PATIENT_BOT_TOKEN=
PATIENT_BOT_USERNAME=

# --- TurboSMS: Viber з резервом SMS (кабінет TurboSMS → API → HTTP API → токен; альфа-імена мають бути зареєстровані)
TURBOSMS_TOKEN=
TURBOSMS_SENDER_SMS=
TURBOSMS_SENDER_VIBER=
TURBOSMS_VIBER_TTL=3600
# оцінка вартості для превʼю розсилок, грн
SMS_PRICE=1.0
VIBER_PRICE=0.7

# --- Правила розсилок
QUIET_HOURS_START=20
QUIET_HOURS_END=9
MARKETING_FREQUENCY_DAYS=14
MARKETING_FOOTER=Відписатися — STOP
